[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = ShengMenuDiskDxe
  FILE_GUID      = 3C4AB25F-A83A-4DB1-87B0-0807F907CC93
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT    = ShengMenuDiskDxeEntry

[Sources]
  ShengMenuDiskDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  DxeServicesLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid  ## CONSUMES
  gEfiBlockIoProtocolGuid          ## PRODUCES
  gEfiDevicePathProtocolGuid       ## PRODUCES

[Depex]
  gEfiFirmwareVolume2ProtocolGuid
