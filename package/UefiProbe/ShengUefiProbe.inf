## @file
#  Standalone sheng firmware probe, selected only by the UEFI probe build.
#  The GUID deliberately matches UniXNU.efi so UniXNUDxe registers this app.
#  Never include this INF and the ordinary UniXNU application in the same FV.
#
#  Copyright (c) 2026, UniXNU contributors. All rights reserved.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010019
  BASE_NAME      = ShengUefiProbe
  FILE_GUID      = 9B665204-A133-47A2-9396-9E2B370A4E25
  MODULE_TYPE    = UEFI_APPLICATION
  VERSION_STRING = 0.1
  ENTRY_POINT    = ShengUefiProbeEntry

[Sources]
  ShengUefiProbe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  DebugLib
  MemoryAllocationLib
  PrintLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid  ## CONSUMES
  gEfiSerialIoProtocolGuid        ## CONSUMES
